{
  "name": "stoploss-api",
  "version": "0.1.0",
  "private": true,
  "description": "Stop-loss claims monitor API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "migrate": "node-pg-migrate up -m migrations --migrations-table pgmigrations",
    "seed": "node dist/scripts/seed.js",
    "load-sample": "node dist/scripts/load-sample.js",
    "start": "node dist/src/server.js",
    "start:docker": "npm run migrate && npm run seed && npm start",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
